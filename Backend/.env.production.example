# =============================================================================
# Backend production environment — TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to `.env.production` and fill in REAL values. Never commit
# real secrets; this file is a placeholder-only example that IS safe to commit.
#
#   cp .env.production.example .env.production   # then edit
#
# All values below are placeholders/empty on purpose.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Leave empty to keep the local-dev default (SQLite app_data.db). For the
# containerised/production stack, point PostgreSQL here, e.g.
#   postgresql+psycopg2://user:pass@host:5432/db
# A hosted free-tier Postgres (Supabase / Neon) works the same way — the app
# only needs this URL.
DATABASE_URL=

# --- Auth / Secrets ----------------------------------------------------------
# Long random string used to sign JWTs. REQUIRED in production.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Legacy alias for JWT_SECRET (app checks SECRET_KEY first).
SECRET_KEY=

# How long JWTs stay valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API, e.g.
#   https://app.example.com,https://admin.example.com
# Leave empty/"*" only for local development.
ALLOWED_ORIGINS=

# --- Services ----------------------------------------------------------------
# URL of the AI / MediaPipe service. Defaults inside the compose network to
# http://ai-service:8001
AI_SERVICE_URL=

# --- Email (optional) --------------------------------------------------------
EMAIL_HOST=
EMAIL_APP_PASSWORD=
EMAIL_SENDER=

# --- Server ------------------------------------------------------------------
# Uvicorn port + worker count used by the container CMD.
PORT=8000
WEB_CONCURRENCY=4

# --- Certificates / PDF output -------------------------------------------------
PDF_OUTPUT_DIR=