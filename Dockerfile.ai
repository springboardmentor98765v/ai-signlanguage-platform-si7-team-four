FROM python:3.12-slim

WORKDIR /code

# OpenCV / MediaPipe need these system libraries even in a "slim" image.
# libgles2/libegl1/libgbm1 specifically fix MediaPipe's Tasks API (HandLandmarker),
# which needs OpenGL ES / EGL bindings even for CPU-only inference.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgles2 \
    libegl1 \
    libgbm1 \
    && rm -rf /var/lib/apt/lists/*

COPY AIML_CV/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt
    
#COPY ONLY required production modules and model artifacts (excludes dataset/raw & notebooks)
COPY AIML_CV/api ./AIML_CV/api
COPY AIML_CV/cv ./AIML_CV/cv
COPY AIML_CV/ml/sign_model.joblib ./AIML_CV/ml/sign_model.joblib
COPY AIML_CV/ml/dynamic_templates.joblib ./AIML_CV/ml/dynamic_templates.joblib
COPY AIML_CV/ml/optimize_model.py ./AIML_CV/ml/optimize_model.py
COPY AIML_CV/models ./AIML_CV/models

WORKDIR /code/AIML_CV/api

EXPOSE 8001

HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=20s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=5)"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
